rules_version = '2';
// 泰山木POS の置き場（Cloud Firestore）の決まり。
// 一般に公開しても、ほかのお店の販売会を見たり、勝手に会計したりできないようにする。
// 考え方と、決まりを公開する手順は docs/一般公開の準備.md を見てください。
//
// しくみ（いちばん大事なことだけ）
// ・端末は「お店」に入る。お店に入っている端末（お店のメンバー）だけが、そのお店の販売会を読み書きできる。
//     owner   … オーナー（端末を入れる・外す・お店の鍵を作る）
//     staff   … レジ・KD・ハンディ（開店・会計・注文・在庫）
//     display … CD・呼び出し番号（映すだけ。会計の記録は読めない）
// ・お店に端末を入れる道は3つだけ：
//     1) お店を作った端末が、自分をオーナーにする
//     2) オーナーが「端末を入れる」を開いている間（10分）に、合言葉を知っている端末がお願いを出し、オーナーが許可する
//     3) 紙に印刷した「お店の鍵」を使う（オーナーの端末を全部なくした時）
// ・お客様（モバイルオーダー）は、メニューなど公開用の文書だけを読み、自分の注文を作って、自分の注文だけを読める。
// ・だれがいつ端末を入れた・外した・鍵を使ったかは「お店の記録」に残り、あとから消せない。
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function me() { return request.auth.uid; }
    function str(v, n) { return v is string && v.size() <= n; }
    function evPath(code) { return /databases/$(database)/documents/events/$(code); }
    function shopPath(s) { return /databases/$(database)/documents/shops/$(s); }
    function memPath(s, uid) { return /databases/$(database)/documents/shops/$(s)/members/$(uid); }
    function evExists(code) { return exists(evPath(code)); }
    function ev(code) { return get(evPath(code)).data; }
    function evShop(code) { return ev(code).get('shop', ''); }
    function evOpen(code) { return evExists(code) && ev(code).get('status', '') == 'open'; }
    function evClosed(code) { return evExists(code) && ev(code).get('status', '') == 'closed'; }
    // お店のメンバーか・役割
    function shopMem(s) { return signedIn() && s is string && s.size() >= 16 && exists(memPath(s, me())); }
    function shopRole(s) { return get(memPath(s, me())).data.role; }
    function shopOwner(s) { return shopMem(s) && shopRole(s) == 'owner'; }
    function shopStaff(s) { return shopMem(s) && shopRole(s) in ['owner', 'staff']; }
    // 販売会：その販売会のお店のメンバーか
    function isMember(code) { return signedIn() && evExists(code) && shopMem(evShop(code)); }
    function isStaff(code) { return isMember(code) && shopRole(evShop(code)) in ['owner', 'staff']; }
    function isOwner(code) { return isMember(code) && shopRole(evShop(code)) == 'owner'; }
    // 数を1つずつ数える文書（番号札・伝票番号）。1つ増やすことだけができる
    function countUp() {
      return request.resource.data.keys().hasOnly(['n'])
        && request.resource.data.n is int
        && request.resource.data.n == (resource == null ? 0 : resource.data.n) + 1;
    }
    // お店の鍵を使っている（「この鍵を持っています」を、置き場の時刻で10分以内に書いた）
    function claimPath(s) { return /databases/$(database)/documents/shops/$(s)/claims/$(request.auth.uid); }
    function keyClaimOk(s) {
      return exists(claimPath(s))
        && get(claimPath(s)).data.at > request.time - duration.value(10, 'm')
        && exists(/databases/$(database)/documents/shops/$(s)/keys/$(get(claimPath(s)).data.k));
    }
    // 「端末を入れる」の合言葉が、いま使える（オーナーが開いてから min 分の間）
    function addPath(s, t) { return /databases/$(database)/documents/shops/$(s)/adds/$(t); }
    function addOpen(s, t) {
      return exists(addPath(s, t))
        && get(addPath(s, t)).data.at + duration.value(get(addPath(s, t)).data.min, 'm') > request.time;
    }

    // ---- お店 ----
    // 文書の中身は、印刷したQRコードの行き先（いま開いている販売会）だけ。だれでも1件ずつ読めるが、一覧は出ない。
    match /shops/{s} {
      allow get: if signedIn();
      allow list: if false;
      // 新しいお店：作った端末が、同時に自分をオーナーにする
      allow create: if signedIn() && s.size() >= 16 && shopShape()
        && request.resource.data.get('owners', null) == null
        && request.resource.data.by == me()
        && existsAfter(memPath(s, me())) && getAfter(memPath(s, me())).data.role == 'owner';
      // 行き先を書く：お店のオーナー・レジ（前の版の owners は書きかえられない）
      allow update: if shopStaff(s) && shopShape()
        && request.resource.data.get('owners', null) == resource.data.get('owners', null);
      allow delete: if false;
      function shopShape() {
        let d = request.resource.data;
        return d.keys().hasOnly(['event', 'name', 'open', 'at', 'by', 'owners'])
          && (d.get('event', '') == null || str(d.get('event', ''), 40))
          && str(d.get('name', ''), 60);
      }

      // お店のメンバー（この端末たちだけが、お店の販売会を読み書きできる）
      match /members/{uid} {
        allow get: if signedIn() && (uid == me() || shopMem(s));
        allow list: if shopMem(s);
        allow create: if signedIn() && memberShape() && (
            // 1) お店を作った端末（お店と同時に）
            (uid == me() && request.resource.data.role == 'owner' && !exists(shopPath(s))
              && getAfter(shopPath(s)).data.get('by', '') == me())
            // 2) オーナーが入れる（お願いを許可した時）
            || shopOwner(s)
            // 3) お店の鍵を使った端末
            || (uid == me() && request.resource.data.role == 'owner' && keyClaimOk(s))
            // 4) 前の版のお店のオーナー（お店の文書の owners に書いてある端末）
            || (uid == me() && request.resource.data.role == 'owner' && exists(shopPath(s))
              && me() in get(shopPath(s)).data.get('owners', []))
          );
        // 変える：オーナーは何でも。自分は名前・使い方・最後に使った時だけ（役割は変えられない）
        allow update: if memberShape() && (shopOwner(s)
          || (uid == me() && shopMem(s)
            && request.resource.data.role == resource.data.role
            && request.resource.data.get('by', '') == resource.data.get('by', '')
            && request.resource.data.get('via', '') == resource.data.get('via', '')));
        // 外す：オーナー・自分で抜ける
        allow delete: if signedIn() && (uid == me() || shopOwner(s));
        function memberShape() {
          let d = request.resource.data;
          return d.keys().hasOnly(['role', 'name', 'kind', 'at', 'by', 'via', 'seen'])
            && d.role in ['owner', 'staff', 'display']
            && str(d.get('name', ''), 40) && str(d.get('kind', ''), 12);
        }
      }

      // 「端末を入れる」の合言葉（オーナーが開く。置き場の時刻で min 分だけ）。読めるのはオーナーだけ
      match /adds/{t} {
        allow get, list: if shopOwner(s);
        allow create: if shopOwner(s) && t.size() >= 8
          && request.resource.data.keys().hasOnly(['at', 'min', 'by'])
          && request.resource.data.at == request.time && request.resource.data.by == me()
          && request.resource.data.min is int && request.resource.data.min >= 1 && request.resource.data.min <= 30;
        allow update: if false;
        allow delete: if shopOwner(s);
      }

      // お店に入れてほしいお願い（合言葉が使える間だけ出せる）。オーナーが許可するとメンバーになる
      match /requests/{uid} {
        allow get: if signedIn() && (uid == me() || shopOwner(s));
        allow list: if shopOwner(s);
        allow create, update: if signedIn() && uid == me()
          && request.resource.data.keys().hasOnly(['name', 'kind', 'role', 't', 'at'])
          && str(request.resource.data.get('name', ''), 30) && str(request.resource.data.get('kind', ''), 12)
          && request.resource.data.role in ['staff', 'display']
          && str(request.resource.data.t, 40) && addOpen(s, request.resource.data.t)
          && request.resource.data.at is int;
        allow delete: if signedIn() && (uid == me() || shopOwner(s));
      }

      // お店の鍵（印刷して保管する、長い合言葉）。鍵そのものは文書の名前にだけ置き、読めるのはオーナーだけ
      match /keys/{k} {
        allow get, list: if shopOwner(s);
        allow create: if shopOwner(s) && k.size() >= 20
          && request.resource.data.keys().hasOnly(['at', 'by']) && request.resource.data.by == me();
        allow update: if false;
        allow delete: if shopOwner(s);
      }
      // 鍵を使う：自分の名前で「この鍵を持っています」を書く（時刻は置き場の時刻。10分だけ有効）
      match /claims/{uid} {
        allow get: if signedIn() && (uid == me() || shopOwner(s));
        allow create, update: if signedIn() && uid == me()
          && request.resource.data.keys().hasOnly(['k', 'at'])
          && str(request.resource.data.k, 64) && request.resource.data.k.size() >= 20
          && request.resource.data.at == request.time
          && exists(/databases/$(database)/documents/shops/$(s)/keys/$(request.resource.data.k));
        allow delete: if signedIn() && (uid == me() || shopOwner(s));
      }

      // お店の記録（端末を入れた・外した・鍵を使った…）。書き足すだけで、あとから直せない・消せない
      match /log/{id} {
        allow get, list: if shopOwner(s);
        allow create: if signedIn() && (shopMem(s) || existsAfter(memPath(s, me())))
          && request.resource.data.keys().hasOnly(['t', 'by', 'at', 'name', 'who'])
          && request.resource.data.by == me() && request.resource.data.at == request.time
          && str(request.resource.data.t, 20) && str(request.resource.data.get('name', ''), 40)
          && str(request.resource.data.get('who', ''), 128);
        allow update, delete: if false;
      }
    }

    // 合言葉・お店の鍵から、どのお店かを引く（知っている人だけが引ける。一覧は出さない）
    match /addcodes/{t} {
      allow get: if signedIn();
      allow list: if false;
      allow create: if signedIn() && t.size() >= 8
        && request.resource.data.keys().hasOnly(['shop', 'at'])
        && shopOwner(request.resource.data.shop)
        && existsAfter(addPath(request.resource.data.shop, t));
      allow update: if false;
      allow delete: if signedIn() && shopOwner(resource.data.shop);
    }
    match /shopkeys/{k} {
      allow get: if signedIn();
      allow list: if false;
      allow create: if signedIn() && k.size() >= 20
        && request.resource.data.keys().hasOnly(['shop', 'at'])
        && shopOwner(request.resource.data.shop)
        && existsAfter(/databases/$(database)/documents/shops/$(request.resource.data.shop)/keys/$(k));
      allow update: if false;
      allow delete: if signedIn() && shopOwner(resource.data.shop);
    }

    // ---- 販売会 ----
    match /events/{code} {
      allow get: if isMember(code);
      allow list: if false;           // 販売会の一覧は、だれにも見せない
      // 開店：お店のオーナー・レジが、自分のお店の販売会として作る
      allow create: if signedIn() && code.size() >= 6
        && request.resource.data.owner == me()
        && shopStaff(request.resource.data.get('shop', ''));
      // 中身を変える：お店のオーナー・レジ（開いた端末と、どのお店かは変えられない）
      allow update: if isStaff(code)
        && request.resource.data.get('owner', '') == resource.data.get('owner', '')
        && request.resource.data.get('shop', '') == resource.data.get('shop', '');
      // 消す：オーナーか、閉店した後の片づけ
      allow delete: if isOwner(code) || (isStaff(code) && resource.data.get('status', '') == 'closed');

      // その時々の表示（お客様用の文書と、お店の中だけの文書がある）
      match /live/{d} {
        // お客様も読める：メニュー・写真・いちばん上の絵・動いている印・公開用のお店の設定・待っている組
        allow get: if (signedIn() && d in ['menu', 'menuimg', 'mhero', 'alive', 'pub', 'queue', 'mseq', 'bseq']) || isMember(code);
        allow list: if isMember(code);
        allow write: if isStaff(code);
        // CD（映すだけの端末）も筆談には書ける
        allow write: if d == 'hitsu' && isMember(code);
        // お客様：番号札・伝票番号を1つずつ数える（受付中の時だけ）
        allow create, update: if signedIn() && d in ['mseq', 'bseq'] && evOpen(code) && countUp();
      }

      // お客様ひとりの注文の数（1回の販売会で30件まで。いたずらで注文を大量に送れないように）
      match /cust/{uid} {
        allow get: if signedIn() && (uid == me() || isStaff(code));
        allow list: if isStaff(code);
        allow create, update: if signedIn() && uid == me() && evOpen(code)
          && request.resource.data.keys().hasOnly(['n']) && request.resource.data.n is int
          && request.resource.data.n == (resource == null ? 0 : resource.data.n) + 1
          && request.resource.data.n <= 30;
        allow delete: if isStaff(code) && evClosed(code);
      }

      // 注文（キッチン）
      match /orders/{id} {
        allow get, list: if isMember(code) || (signedIn() && resource.data.uid == me());
        allow create: if isStaff(code) || customerOrder();
        allow update, delete: if isStaff(code);
        function custPath() { return /databases/$(database)/documents/events/$(code)/cust/$(request.auth.uid); }
        function customerOrder() {
          let d = request.resource.data;
          return signedIn() && evOpen(code)
            && ev(code).get('mobile', {}).get('on', false) == true
            && d.keys().hasOnly(['id', 'no', 'at', 'dine', 'items', 'st', 'channel', 'paid', 'total', 'uid', 'roundId',
                                 'upd', 'chk', 't', 'dev', 'discount', 'pickupAt', 'seat', 'coupon', 'memo', 'table', 'billId'])
            && d.id == id && d.uid == me() && d.channel == 'mobile' && d.paid == false && d.st == 'cook'
            && d.items is list && d.items.size() >= 1 && d.items.size() <= 40
            && str(d.no, 8) && d.dine in ['take', 'eat']
            && d.chk is list && d.chk.size() == 0 && d.t is map && d.t.size() == 0
            && (d.get('memo', '') == '' || str(d.get('memo', ''), 300))
            && (d.get('seat', '') == '' || str(d.get('seat', ''), 20))
            && d.get('roundId', '') == ev(code).get('roundId', '')
            // 注文の数を、同時に1つ数える（上限は cust の決まり）
            && getAfter(custPath()).data.n == (exists(custPath()) ? get(custPath()).data.n : 0) + 1
            // テーブルの伝票に足す時は、そのテーブルの伝票だけ
            && (d.get('billId', '') == '' || get(/databases/$(database)/documents/events/$(code)/bills/$(d.billId)).data.table == d.get('table', ''));
        }
      }

      // テーブルの印（レストラン）。どの伝票が開いているかだけ
      match /tables/{t} {
        allow get: if signedIn();
        allow list: if isMember(code);
        allow write: if isStaff(code);
        // お客様：新しく開いた伝票を、このテーブルの印にする（開いている伝票を横取りできない）
        allow create, update: if signedIn() && evOpen(code)
          && request.resource.data.keys().hasOnly(['bill', 'roundId'])
          && str(request.resource.data.bill, 60)
          && !exists(/databases/$(database)/documents/events/$(code)/bills/$(request.resource.data.bill))
          && getAfter(/databases/$(database)/documents/events/$(code)/bills/$(request.resource.data.bill)).data.table == t
          && (resource == null || !exists(/databases/$(database)/documents/events/$(code)/bills/$(resource.data.bill))
              || get(/databases/$(database)/documents/events/$(code)/bills/$(resource.data.bill)).data.st != 'open'
              || resource.data.get('roundId', '') != ev(code).get('roundId', ''));
      }

      // 伝票（レストラン）
      match /bills/{b} {
        allow get: if signedIn();
        allow list: if isMember(code);
        allow create: if isStaff(code) || (signedIn() && evOpen(code)
          && request.resource.data.keys().hasOnly(['id', 'no', 'table', 'st', 'at', 'by', 'roundId', 'paid', 'pays'])
          && request.resource.data.id == b && request.resource.data.st == 'open' && request.resource.data.by == 'mobile'
          && request.resource.data.paid is map && request.resource.data.paid.size() == 0
          && request.resource.data.pays is list && request.resource.data.pays.size() == 0
          && getAfter(/databases/$(database)/documents/events/$(code)/tables/$(request.resource.data.table)).data.bill == b);
        allow update, delete: if isStaff(code);
      }

      // 会計の記録：お店のオーナー・レジ。消すのは閉店した後の片づけだけ
      match /sales/{id} {
        allow read: if isStaff(code);
        allow create, update: if isStaff(code);
        allow delete: if isStaff(code) && evClosed(code);
      }
      match /reservations/{id} {
        allow read, write: if isStaff(code);
      }
      // 端末の一覧（在席）。CD も自分の在席を書く
      match /devices/{id} {
        allow read, write: if isMember(code);
      }
      // 商品の写真（小さい物・印刷用の大きい控え）
      match /img/{id} {
        allow read: if isMember(code);
        allow write: if isStaff(code);
      }
      match /imgh/{id} {
        allow read, write: if isStaff(code);
      }
    }
  }
}
