rules_version = '2';
// 泰山木POS の置き場（Cloud Firestore）の決まり。
// 一般に公開しても、ほかのお店の販売会を見たり、勝手に会計したりできないようにする。
// 考え方と、決まりを公開する手順は docs/一般公開の準備.md を見てください。
//
// ・だれでも匿名でログインする（名前・メールは聞かない）。ログインした「印」（uid）で見分ける。
// ・販売会（events/{コード}）の中身を読み書きできるのは、その販売会の「メンバー」の端末だけ。
//     owner   … オーナー（メンバーを足す・外す・招待を作る）。開店した端末と、
//                「お店のオーナー」（shops/{印}.owners）にした端末
//     staff   … レジ・KD・ハンディ（会計・注文・在庫）
//     display … CD・呼び出し番号（映すだけ。会計はしない）
// ・メンバーになる道は4つだけ：
//     1) 開店した端末が、販売会を作るのと同時に、自分をオーナーにする
//     2) オーナーが足す（合流のお願いを「許可」した時・いつもの端末を呼んだ時）
//     3) オーナーが作った「合流の合言葉」（30分・1回だけ）を使う
//     4) お店のオーナーの端末が、そのお店の販売会のオーナーになる（開店した端末の電池が切れた時の控え）
//   お店のオーナーには、ほかのオーナーが足すか、「お店の鍵」（印刷して保管する）を使ってなる。
//   共有コード（6けた）を知っているだけでは、合流のお願いを出せるだけで、中身は何も読めない。
// ・お客様（モバイルオーダー）は、メニューなど公開用の文書だけを読み、
//   自分の注文を作って、自分の注文だけを読める。ほかのお客様の注文は読めない。
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function me() { return request.auth.uid; }
    function evPath(code) { return /databases/$(database)/documents/events/$(code); }
    function memPath(code, uid) { return /databases/$(database)/documents/events/$(code)/members/$(uid); }
    function isMember(code) { return signedIn() && exists(memPath(code, me())); }
    function roleOf(code) { return get(memPath(code, me())).data.role; }
    function isStaff(code) { return isMember(code) && roleOf(code) in ['owner', 'staff']; }
    function isOwner(code) { return isMember(code) && roleOf(code) == 'owner'; }
    function evExists(code) { return exists(evPath(code)); }
    function ev(code) { return get(evPath(code)).data; }
    function evOpen(code) { return evExists(code) && ev(code).get('status', '') == 'open'; }
    function evClosed(code) { return evExists(code) && ev(code).get('status', '') == 'closed'; }
    function str(v, n) { return v is string && v.size() <= n; }
    function nowMs() { return request.time.toMillis(); }
    function invPath(code, t) { return /databases/$(database)/documents/events/$(code)/invites/$(t); }
    // 数を1つずつ数える文書（番号札・伝票番号）。1つ増やすことだけができる
    function countUp() {
      return request.resource.data.keys().hasOnly(['n'])
        && request.resource.data.n is int
        && request.resource.data.n == (resource == null ? 0 : resource.data.n) + 1;
    }

    // ---- お店（印刷したQRコードが指す先。オーナーの端末が「いま開いている販売会」を書く）----
    // QRコードには、このお店の印だけを入れる。印を知らないお店は探せない（一覧は出さない）。
    match /shops/{shopId} {
      allow get: if signedIn();
      allow list: if false;
      allow create: if signedIn() && shopId.size() >= 16
        && request.resource.data.owners == [me()]
        && shopShape();
      // 書きかえる：お店のオーナー（ほかのオーナーを足す・外すこともできる。端末をなくした時に外すため）。
      // お店の鍵を使った端末は、自分をオーナーに足せる。自分を外すことはできない（だれもいないお店にしない）
      allow update: if signedIn() && (me() in resource.data.owners || keyClaimOk(shopId))
        && me() in request.resource.data.owners
        && request.resource.data.owners.size() <= 10
        && shopShape();
      allow delete: if false;
      function shopShape() {
        let d = request.resource.data;
        return d.keys().hasOnly(['owners', 'event', 'name', 'at', 'open'])
          && d.owners is list && (d.get('event', '') == null || str(d.get('event', ''), 40))
          && str(d.get('name', ''), 60);
      }
      // お店の鍵（印刷して保管する、長い合言葉）。鍵そのものは文書の名前にだけ置き、読めるのはオーナーだけ
      match /keys/{k} {
        allow get, list: if signedIn() && me() in get(shopPath(shopId)).data.owners;
        allow create: if signedIn() && me() in get(shopPath(shopId)).data.owners && k.size() >= 20
          && request.resource.data.keys().hasOnly(['at', 'by']) && request.resource.data.by == me();
        allow update: if false;
        allow delete: if signedIn() && me() in get(shopPath(shopId)).data.owners;
      }
      // 鍵を使う：自分の名前で「この鍵を持っています」を書く（時刻は置き場の時刻。10分だけ有効）
      match /claims/{uid} {
        allow get: if signedIn() && (uid == me() || me() in get(shopPath(shopId)).data.owners);
        allow create, update: if signedIn() && uid == me()
          && request.resource.data.keys().hasOnly(['k', 'at'])
          && str(request.resource.data.k, 64) && request.resource.data.k.size() >= 20
          && request.resource.data.at == request.time
          && exists(/databases/$(database)/documents/shops/$(shopId)/keys/$(request.resource.data.k));
        allow delete: if signedIn() && (uid == me() || me() in get(shopPath(shopId)).data.owners);
      }
    }
    // お店の鍵から、どのお店かを引く（鍵を知っている人だけが引ける。一覧は出さない）
    match /shopkeys/{k} {
      allow get: if signedIn();
      allow list: if false;
      allow create: if signedIn() && k.size() >= 20
        && request.resource.data.keys().hasOnly(['shop', 'at'])
        && request.resource.data.shop is string && request.resource.data.shop.size() >= 16
        && me() in get(shopPath(request.resource.data.shop)).data.owners
        && existsAfter(/databases/$(database)/documents/shops/$(request.resource.data.shop)/keys/$(k));
      allow update: if false;
      allow delete: if signedIn() && me() in get(shopPath(resource.data.shop)).data.owners;
    }
    // ---- 販売会の予定と予約フォーム（plans/{予定の印}）----
    // 予定を作った端末（owners）が、お客様の読む文書（名前・日時・場所・予約できる品・受付の期間）を書く。
    // 予定の印は長い乱数で、知らない予定は探せない（一覧は出さない）。
    // お客様は、受付の期間の間だけ、自分の予約を1つずつ作れる。読めるのは自分の予約だけ。
    // 予約の一覧を読めるのは、予定を作った端末だけ。予約は、だれも消せない（取り消しは状態を変えるだけ）。
    function planPath(pid) { return /databases/$(database)/documents/plans/$(pid); }
    function planOwner(pid) { return signedIn() && exists(planPath(pid)) && me() in get(planPath(pid)).data.owners; }
    function planResvOpen(pid) {
      let p = get(planPath(pid)).data;
      return p.get('on', false) == true && request.time.toMillis() >= p.get('from', 0) && request.time.toMillis() < p.get('to', 0);
    }
    match /plans/{pid} {
      allow get: if signedIn();
      allow list: if false;
      allow create: if signedIn() && pid.size() >= 16 && request.resource.data.owners == [me()] && planShape();
      allow update: if signedIn() && me() in resource.data.owners && me() in request.resource.data.owners
        && request.resource.data.owners.size() <= 10 && planShape();
      allow delete: if signedIn() && me() in resource.data.owners;
      function planShape() {
        let d = request.resource.data;
        return d.keys().hasOnly(['owners', 'name', 'date', 'start', 'end', 'place', 'org', 'collab', 'comment', 'shop',
                                 'on', 'from', 'to', 'pickups', 'items', 'tel', 'memo', 'maxQty', 'note', 'at', 'done'])
          && d.owners is list && d.on is bool && d.from is int && d.to is int
          && d.items is list && d.items.size() <= 80 && d.pickups is list && d.pickups.size() <= 48
          && str(d.get('name', ''), 40) && str(d.get('place', ''), 60) && str(d.get('org', ''), 60)
          && str(d.get('collab', ''), 80) && str(d.get('comment', ''), 200) && str(d.get('note', ''), 300)
          && d.get('tel', 'off') in ['off', 'opt', 'req'] && d.get('maxQty', 10) is int && d.get('maxQty', 10) <= 30;
      }
      // 予約の数え（何件目か・品ごとに何個予約されたか）。お客様は、予約を1つ作る時に、1つだけ数を進める
      match /tally/{t} {
        allow get: if signedIn();
        allow write: if planOwner(pid);
        allow create, update: if signedIn() && t == 'c' && planResvOpen(pid)
          && request.resource.data.keys().hasOnly(['n', 'c'])
          && request.resource.data.n is int && request.resource.data.c is map
          && request.resource.data.n == (resource == null ? 0 : resource.data.n) + 1
          && existsAfter(/databases/$(database)/documents/plans/$(pid)/resv/$('r' + string(request.resource.data.n)));
      }
      // 予約。お客様は自分の予約を作って読むだけ。状態（受け取り・取り消し）を変えるのは予定を作った端末
      match /resv/{rid} {
        allow get: if signedIn() && (resource.data.uid == me() || planOwner(pid));
        allow list: if planOwner(pid) || (signedIn() && resource.data.uid == me());
        allow create: if signedIn() && planResvOpen(pid) && resvShape()
          && rid == 'r' + string(request.resource.data.seq)
          && getAfter(/databases/$(database)/documents/plans/$(pid)/tally/c).data.n == request.resource.data.seq;
        allow update: if planOwner(pid)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['st', 'stAt'])
          && request.resource.data.st in ['new', 'done', 'cancel'];
        allow delete: if false;   // 予約は消さない
        function resvShape() {
          let d = request.resource.data;
          return d.keys().hasOnly(['uid', 'seq', 'name', 'tel', 'memo', 'pickup', 'items', 'total', 'st', 'at'])
            && d.uid == me() && d.st == 'new' && d.at == request.time
            && d.seq is int && d.seq >= 1
            && d.name is string && d.name.size() >= 1 && d.name.size() <= 30
            && str(d.get('tel', ''), 20) && str(d.get('memo', ''), 200) && str(d.get('pickup', ''), 5)
            && d.items is list && d.items.size() >= 1 && d.items.size() <= 30
            && d.total is int && d.total >= 0;
        }
      }
    }
    // ---- 予約帳（books/{予約帳の印}）----
    // レジ・販売会・予定とは別の置き場。レジを初期化しても、販売会を閉じても、何も消えない。
    // ・予約帳を作った端末と、「予約帳の鍵」を使った端末が管理者（owners）。鍵は印刷して保管する。
    //   管理の端末をなくしても・初期化しても、鍵があれば、どの端末からでも管理者に戻れる。
    // ・お客様は、受付の期間の間だけ、予約を1つずつ作れる。予約の印は長い乱数で、印を知っている人だけが読める
    //   （お客様の控えのリンク）。一覧を読めるのは管理者だけ。
    // ・予約は、だれにも消せない。管理者も、状態（受け取り・取り消し）と、お店のメモを変えるだけ。
    //   状態を変えた記録（log）は、足すことしかできない（あとから書きかえ・消すことはできない）。
    // ・予約帳そのものも消せない（受付をやめる時は on: false にする）。
    function bookPath(bid) { return /databases/$(database)/documents/books/$(bid); }
    function bookOwner(bid) { return signedIn() && exists(bookPath(bid)) && me() in get(bookPath(bid)).data.owners; }
    function bookOpen(bid) {
      let b = get(bookPath(bid)).data;
      return b.get('on', false) == true && request.time.toMillis() >= b.get('from', 0) && request.time.toMillis() < b.get('to', 0);
    }
    // 予約を足せるか：受付の期間のお客様か、管理者（店頭・電話の予約を、期間の外でも足せる）
    function bookCanAdd(bid) { return bookOpen(bid) || bookOwner(bid); }
    function bookClaimOk(bid) {
      let c = /databases/$(database)/documents/books/$(bid)/claims/$(request.auth.uid);
      return exists(c) && get(c).data.at > request.time - duration.value(10, 'm')
        && exists(/databases/$(database)/documents/books/$(bid)/keys/$(get(c).data.k));
    }
    match /books/{bid} {
      allow get: if signedIn();
      allow list: if false;
      allow create: if signedIn() && bid.size() >= 20 && request.resource.data.owners == [me()] && bookShape();
      // 書きかえる：管理者か、鍵を使った端末（自分を管理者に足す）。管理者を0人にはできない
      allow update: if signedIn() && (me() in resource.data.owners || bookClaimOk(bid))
        && me() in request.resource.data.owners && request.resource.data.owners.size() <= 20 && bookShape();
      allow delete: if false;
      function bookShape() {
        let d = request.resource.data;
        return d.keys().hasOnly(['owners', 'title', 'shop', 'lead', 'pickup', 'note', 'on', 'from', 'to', 'items',
                                 'maxQty', 'sidLabel', 'sidReq', 'sheet', 'theme', 'at', 'ver'])
          && d.owners is list && d.owners.size() >= 1 && d.on is bool && d.from is int && d.to is int
          && d.items is list && d.items.size() <= 20
          && str(d.get('title', ''), 40) && str(d.get('shop', ''), 60) && str(d.get('lead', ''), 400)
          && str(d.get('pickup', ''), 300) && str(d.get('note', ''), 400) && str(d.get('sidLabel', ''), 16)
          && str(d.get('sheet', ''), 300) && str(d.get('theme', ''), 20)
          && d.get('maxQty', 10) is int && d.get('maxQty', 10) >= 1 && d.get('maxQty', 10) <= 50;
      }
      // 予約の数え（何件目か・品ごとに何個予約されたか）。お客様は、予約を1つ作る時に、番号を1つだけ進める
      match /tally/{t} {
        allow get: if signedIn();
        // 管理者は数え直せる。ただし番号を戻すことはできない（戻すと、次の予約が前の番号とぶつかるため）
        allow write: if bookOwner(bid) && t == 'c'
          && request.resource.data.n is int && request.resource.data.n >= (resource == null ? 0 : resource.data.n);
        allow create, update: if signedIn() && t == 'c' && bookCanAdd(bid)
          && request.resource.data.keys().hasOnly(['n', 'c'])
          && request.resource.data.n is int && request.resource.data.c is map
          && request.resource.data.n == (resource == null ? 0 : resource.data.n) + 1
          && existsAfter(/databases/$(database)/documents/books/$(bid)/seq/$('s' + string(request.resource.data.n)));
      }
      // 番号 → 予約の印（番号がとびとびにならない・同じ番号が2つできないように。足すだけ）
      match /seq/{s} {
        allow get: if bookOwner(bid);
        allow list: if bookOwner(bid);
        allow create: if signedIn() && bookCanAdd(bid)
          && request.resource.data.keys().hasOnly(['r'])
          && str(request.resource.data.r, 40)
          && s == 's' + string(getAfter(/databases/$(database)/documents/books/$(bid)/tally/c).data.n)
          && getAfter(/databases/$(database)/documents/books/$(bid)/resv/$(request.resource.data.r)).data.seq
             == getAfter(/databases/$(database)/documents/books/$(bid)/tally/c).data.n;
        allow update, delete: if false;
      }
      // 予約
      match /resv/{rid} {
        // 予約の印（20文字以上の乱数）を知っている人は読める（お客様の控えのリンク）。一覧は管理者だけ
        allow get: if signedIn();
        allow list: if bookOwner(bid);
        allow create: if signedIn() && bookCanAdd(bid) && rid.size() >= 20 && resvShape()
          && getAfter(/databases/$(database)/documents/books/$(bid)/tally/c).data.n == request.resource.data.seq
          && getAfter(/databases/$(database)/documents/books/$(bid)/seq/$('s' + string(request.resource.data.seq))).data.r == rid;
        // 管理者：状態・お店のメモ・お支払いの印だけを変えられる（お客様が書いた中身は変えない）
        allow update: if bookOwner(bid)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['st', 'stAt', 'stBy', 'snote', 'paid'])
          && request.resource.data.st in ['new', 'done', 'cancel']
          && str(request.resource.data.get('snote', ''), 200)
          && request.resource.data.get('paid', false) is bool;
        allow delete: if false;   // 予約は、だれにも消せない
        function resvShape() {
          let d = request.resource.data;
          return d.keys().hasOnly(['uid', 'seq', 'name', 'sid', 'items', 'qty', 'total', 'st', 'at', 'cat', 'via'])
            && str(d.get('via', 'web'), 10)
            && d.uid == me() && d.st == 'new' && d.at == request.time
            && d.seq is int && d.seq >= 1
            && d.name is string && d.name.size() >= 1 && d.name.size() <= 30
            && str(d.get('sid', ''), 20)
            && d.items is list && d.items.size() >= 1 && d.items.size() <= 20
            && d.qty is int && d.qty >= 1 && d.qty <= 50
            && d.total is int && d.total >= 0
            && d.get('cat', 0) is int;
        }
      }
      // 状態を変えた記録（管理者が足す。書きかえ・消すことはできない）
      match /log/{id} {
        allow get, list: if bookOwner(bid);
        allow create: if bookOwner(bid)
          && request.resource.data.keys().hasOnly(['at', 'by', 'rid', 'act', 'from', 'to', 'who', 'note'])
          && request.resource.data.by == me() && request.resource.data.at == request.time
          && str(request.resource.data.rid, 40) && str(request.resource.data.act, 20)
          && str(request.resource.data.get('who', ''), 40) && str(request.resource.data.get('note', ''), 200);
        allow update, delete: if false;
      }
      // 学籍番号ごとの予約の数（同じ番号での予約に気づけるように。番号そのものは置かず、ハッシュだけ）
      match /sid/{h} {
        allow get: if signedIn();
        allow list: if bookOwner(bid);
        allow create, update: if signedIn() && bookCanAdd(bid) && h.size() >= 16
          && request.resource.data.keys().hasOnly(['n'])
          && request.resource.data.n == (resource == null ? 0 : resource.data.n) + 1;
        allow delete: if false;
      }
      // 予約帳の鍵（印刷して保管する長い合言葉）。読めるのは管理者だけ
      match /keys/{k} {
        allow get, list: if bookOwner(bid);
        allow create: if bookOwner(bid) && k.size() >= 20
          && request.resource.data.keys().hasOnly(['at', 'by']) && request.resource.data.by == me();
        allow update: if false;
        allow delete: if bookOwner(bid);
      }
      // 鍵を使う：自分の名前で「この鍵を持っています」を書く（時刻は置き場の時刻。10分だけ有効）
      match /claims/{uid} {
        allow get: if signedIn() && (uid == me() || bookOwner(bid));
        allow create, update: if signedIn() && uid == me()
          && request.resource.data.keys().hasOnly(['k', 'at'])
          && str(request.resource.data.k, 64) && request.resource.data.k.size() >= 20
          && request.resource.data.at == request.time
          && exists(/databases/$(database)/documents/books/$(bid)/keys/$(request.resource.data.k));
        allow delete: if signedIn() && (uid == me() || bookOwner(bid));
      }
    }
    // 予約帳の鍵から、どの予約帳かを引く（鍵を知っている人だけが引ける。一覧は出さない）
    match /bookkeys/{k} {
      allow get: if signedIn();
      allow list: if false;
      allow create: if signedIn() && k.size() >= 20
        && request.resource.data.keys().hasOnly(['book', 'at'])
        && request.resource.data.book is string && request.resource.data.book.size() >= 20
        && me() in get(bookPath(request.resource.data.book)).data.owners
        && existsAfter(/databases/$(database)/documents/books/$(request.resource.data.book)/keys/$(k));
      allow update, delete: if false;
    }

    function shopPath(shopId) { return /databases/$(database)/documents/shops/$(shopId); }
    function claimPath(shopId) { return /databases/$(database)/documents/shops/$(shopId)/claims/$(request.auth.uid); }
    function keyClaimOk(shopId) {
      return exists(claimPath(shopId))
        && get(claimPath(shopId)).data.at > request.time - duration.value(10, 'm')
        && exists(/databases/$(database)/documents/shops/$(shopId)/keys/$(get(claimPath(shopId)).data.k));
    }
    // この販売会のお店のオーナーか（開店した端末の控えのオーナー）
    function shopOwnerOf(code) {
      return evExists(code) && ev(code).get('shop', '') is string && ev(code).get('shop', '').size() >= 16
        && exists(shopPath(ev(code).shop))
        && me() in get(shopPath(ev(code).shop)).data.owners;
    }

    // ---- 合流の知らせ（いつもの端末へ。オーナーが開店した時に「合流しますか」を届ける）----
    match /users/{uid}/inbox/{code} {
      allow read, delete: if signedIn() && uid == me();
      allow create, update: if signedIn()
        && exists(memPath(code, me())) && get(memPath(code, me())).data.role == 'owner'
        && existsAfter(memPath(code, uid))
        && request.resource.data.keys().hasOnly(['code', 'name', 'at', 'from', 'role', 'kind', 'shop'])
        && request.resource.data.code == code && request.resource.data.from == me()
        && str(request.resource.data.get('name', ''), 60);
    }

    // ---- 販売会 ----
    match /events/{code} {
      allow get: if isMember(code);
      allow list: if false;           // 販売会の一覧は、だれにも見せない
      // 新しく作る：作った端末がオーナー（作る時に owner に自分を書く）
      allow create: if signedIn() && code.size() >= 6
        && request.resource.data.owner == me();
      // 中身を変える：レジ・KD など（オーナーと、お店の印は変えられない）
      allow update: if isStaff(code)
        && request.resource.data.get('owner', '') == resource.data.get('owner', '')
        && (request.resource.data.get('shop', '') == resource.data.get('shop', '') || isOwner(code));
      // 消す：オーナーか、閉店した後の片づけ
      allow delete: if isOwner(code) || (isStaff(code) && resource.data.get('status', '') == 'closed');

      // メンバー
      match /members/{uid} {
        allow get: if signedIn() && (uid == me() || isMember(code));
        allow list: if isMember(code);
        allow create: if signedIn() && memberShape() && (
            // 1) 開店した端末が、販売会を作るのと同時に、自分をオーナーにする
            //    （作った後はこの道を使えない。外された開店した端末が、自分をオーナーに戻せないように）
            (uid == me() && request.resource.data.role == 'owner' && !evExists(code)
              && getAfter(evPath(code)).data.get('owner', '') == me())
            // 2) オーナーが足す
            || isOwner(code)
            // 3) 合流の合言葉（30分・1回だけ）。合言葉と同じ役割でだけ入れる。使った合言葉は同時に消す
            || (uid == me() && request.resource.data.role in ['staff', 'display']
              && str(request.resource.data.get('inv', null), 40)
              && exists(invPath(code, request.resource.data.inv))
              && get(invPath(code, request.resource.data.inv)).data.at + duration.value(get(invPath(code, request.resource.data.inv)).data.min, 'm') > request.time
              && get(invPath(code, request.resource.data.inv)).data.role == request.resource.data.role
              && !existsAfter(invPath(code, request.resource.data.inv)))
            // 4) お店のオーナーの端末は、そのお店の販売会のオーナーになれる
            || (uid == me() && request.resource.data.role == 'owner' && shopOwnerOf(code))
          );
        // 自分の名前を直すのは自分でもよい（役割は変えられない）。役割を変えるのはオーナーだけ
        allow update: if memberShape() && (isOwner(code)
          || (uid == me() && isMember(code) && request.resource.data.role == resource.data.role)
          || (uid == me() && request.resource.data.role == 'owner' && shopOwnerOf(code)));
        // 外す：オーナー（開店した端末も外せる。なくした・盗まれた時のため）・自分で抜ける・閉店した後の片づけ
        allow delete: if signedIn() && (uid == me()
          || isOwner(code)
          || (isStaff(code) && (!evExists(code) || evClosed(code))));
        function memberShape() {
          let d = request.resource.data;
          return d.keys().hasOnly(['role', 'name', 'at', 'by', 'via', 'inv', 'kind'])
            && d.role in ['owner', 'staff', 'display'] && str(d.get('name', ''), 40);
        }
      }

      // 合流の合言葉（オーナーが作る。読めるのはオーナーだけ）。
      // 作った時刻は置き場の時刻（端末の時計がずれていても、期限がずれない）。使えるのは min 分だけ・1回だけ
      match /invites/{token} {
        allow read: if isOwner(code);
        allow create: if isOwner(code) && token.size() >= 8
          && request.resource.data.keys().hasOnly(['role', 'min', 'by', 'at'])
          && request.resource.data.role in ['staff', 'display']
          && request.resource.data.by == me()
          && request.resource.data.at == request.time
          && request.resource.data.min is int && request.resource.data.min >= 1 && request.resource.data.min <= 60;
        allow update: if false;
        // 消す：オーナー・閉店した後の片づけ・この合言葉で入る端末（入るのと同時に消す＝1回だけ）
        allow delete: if isOwner(code) || (isStaff(code) && evClosed(code))
          || (signedIn() && !exists(memPath(code, me())) && existsAfter(memPath(code, me()))
              && getAfter(memPath(code, me())).data.get('inv', '') == token);
      }

      // 合流のお願い（共有コードを知っている端末が出す。オーナーが「許可」するとメンバーになる）
      match /requests/{uid} {
        allow get: if signedIn() && (uid == me() || isMember(code));
        allow list: if isMember(code);
        allow create, update: if signedIn() && uid == me() && evOpen(code)
          && ev(code).get('reqOff', false) != true
          && request.resource.data.keys().hasOnly(['name', 'role', 'at', 'kind'])
          && str(request.resource.data.get('name', ''), 30)
          && request.resource.data.role in ['staff', 'display']
          && str(request.resource.data.get('kind', ''), 12)
          && request.resource.data.at is int;
        allow delete: if signedIn() && (uid == me() || isOwner(code) || (isStaff(code) && evClosed(code)));
      }

      // その時々の表示（お客様用の文書と、お店の中だけの文書がある）
      match /live/{doc} {
        // お客様も読める：メニュー・写真・いちばん上の絵・動いている印・公開用のお店の設定・待っている組
        allow get: if (signedIn() && doc in ['menu', 'menuimg', 'mhero', 'alive', 'pub', 'queue', 'mseq', 'bseq']) || isMember(code);
        allow list: if isMember(code);
        allow write: if isStaff(code);
        // CD（映すだけの端末）も筆談には書ける
        allow write: if doc == 'hitsu' && isMember(code);
        // お客様：番号札・伝票番号を1つずつ数える（受付中の時だけ）
        allow create, update: if signedIn() && doc in ['mseq', 'bseq'] && evOpen(code) && countUp();
      }

      // 注文（キッチン）
      match /orders/{id} {
        allow get, list: if isMember(code) || (signedIn() && resource.data.uid == me());
        allow create: if isStaff(code) || customerOrder();
        allow update, delete: if isStaff(code);
        function customerOrder() {
          let d = request.resource.data;
          return signedIn() && evOpen(code)
            && ev(code).get('mobile', {}).get('on', false) == true
            && d.keys().hasOnly(['id', 'no', 'at', 'dine', 'items', 'st', 'channel', 'paid', 'total', 'uid', 'roundId',
                                 'upd', 'chk', 't', 'dev', 'discount', 'pickupAt', 'seat', 'coupon', 'memo', 'table', 'billId'])
            && d.id == id && d.uid == me() && d.channel == 'mobile' && d.paid == false && d.st == 'cook'
            && d.items is list && d.items.size() >= 1 && d.items.size() <= 40
            && str(d.no, 8) && d.dine in ['take', 'eat']
            && d.chk is list && d.chk.size() == 0 && d.t is map && d.t.size() == 0
            && (d.get('memo', '') == '' || str(d.get('memo', ''), 300))
            && (d.get('seat', '') == '' || str(d.get('seat', ''), 20))
            && d.get('roundId', '') == ev(code).get('roundId', '')
            // テーブルの伝票に足す時は、そのテーブルの伝票だけ
            && (d.get('billId', '') == '' || get(/databases/$(database)/documents/events/$(code)/bills/$(d.billId)).data.table == d.get('table', ''));
        }
      }

      // テーブルの印（レストラン）。どの伝票が開いているかだけ
      match /tables/{t} {
        allow get: if signedIn();
        allow list: if isMember(code);
        allow write: if isStaff(code);
        // お客様：新しく開いた伝票を、このテーブルの印にする（開いている伝票を横取りできない）
        allow create, update: if signedIn() && evOpen(code)
          && request.resource.data.keys().hasOnly(['bill', 'roundId'])
          && str(request.resource.data.bill, 60)
          && !exists(/databases/$(database)/documents/events/$(code)/bills/$(request.resource.data.bill))
          && getAfter(/databases/$(database)/documents/events/$(code)/bills/$(request.resource.data.bill)).data.table == t
          && (resource == null || !exists(/databases/$(database)/documents/events/$(code)/bills/$(resource.data.bill))
              || get(/databases/$(database)/documents/events/$(code)/bills/$(resource.data.bill)).data.st != 'open'
              || resource.data.get('roundId', '') != ev(code).get('roundId', ''));
      }

      // 伝票（レストラン）
      match /bills/{b} {
        allow get: if signedIn();
        allow list: if isMember(code);
        allow create: if isStaff(code) || (signedIn() && evOpen(code)
          && request.resource.data.keys().hasOnly(['id', 'no', 'table', 'st', 'at', 'by', 'roundId', 'paid', 'pays'])
          && request.resource.data.id == b && request.resource.data.st == 'open' && request.resource.data.by == 'mobile'
          && request.resource.data.paid is map && request.resource.data.paid.size() == 0
          && request.resource.data.pays is list && request.resource.data.pays.size() == 0
          && getAfter(/databases/$(database)/documents/events/$(code)/tables/$(request.resource.data.table)).data.bill == b);
        allow update, delete: if isStaff(code);
      }

      // 会計の記録：レジ・KD など。消すのは閉店した後の片づけだけ
      match /sales/{id} {
        allow read: if isStaff(code);
        allow create, update: if isStaff(code);
        allow delete: if isStaff(code) && evClosed(code);
      }
      match /reservations/{id} {
        allow read, write: if isStaff(code);
      }
      // 端末の一覧（在席）。CD も自分の在席を書く
      match /devices/{id} {
        allow read, write: if isMember(code);
      }
      // 商品の写真（小さい物・印刷用の大きい控え）
      match /img/{id} {
        allow read: if isMember(code);
        allow write: if isStaff(code);
      }
      match /imgh/{id} {
        allow read, write: if isStaff(code);
      }
    }
  }
}
